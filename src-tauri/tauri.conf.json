{
  "$schema": "./gen/schemas/desktop-schema.json",
  "productName": "echiquier",
  "version": "0.1.0",
  "identifier": "com.echiquier.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Echiquier",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
